{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": { "distDir": "public" }
        },
        {
            "src": "index.js",
            "use": "@vercel/node",
            "config": { "includeFiles": ["views/admin/**", "public/**"] }
        }
    ],
    "routes": [
        { "handle": "filesystem" },
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ]
}
