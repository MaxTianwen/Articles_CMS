<%- include('partials/start') %>
<div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>Content overview</h1><p>Monitor article status and access content management tools.</p></div><a class="btn btn-primary" href="/articles/add"><%- include('partials/icon', {name:'plus'}) %>New article</a></div>
<div class="stats-grid">
    <% for (const stat of [{label:'Total articles',value:counts.total,icon:'article',tone:'blue',url:'/articles',caption:'All stored articles'}, {label:'Published',value:counts.published,icon:'check',tone:'green',url:'/articles?status=published',caption:'Internal published status'}, {label:'Unpublished',value:counts.drafts,icon:'edit',tone:'amber',url:'/articles?status=draft',caption:'Not marked as published'}, {label:'Categories',value:categories.length,icon:'category',tone:'violet',url:'/categories',caption:'Article classifications'}]) { %>
    <a class="card stat-card" href="<%= stat.url %>"><div class="stat-top"><span><%= stat.label %></span><span class="stat-icon tone-<%= stat.tone %>"><%- include('partials/icon', {name:stat.icon}) %></span></div><strong class="stat-number"><%= stat.value %></strong><span class="stat-caption"><%= stat.caption %></span></a>
    <% } %>
</div>
<section class="card management-actions" aria-labelledby="management-heading"><div><h2 id="management-heading">Content management</h2><p>Create articles, edit existing content, or review unpublished entries.</p></div><div class="management-links"><a class="btn" href="/articles"><%- include('partials/icon',{name:'article'}) %>Manage articles</a><a class="btn" href="/articles?status=draft"><%- include('partials/icon',{name:'edit'}) %>Review unpublished</a></div></section>
<div class="dashboard-grid">
    <section class="card recent-card"><div class="card-header"><div><h2 class="card-title">Recent articles</h2><p class="section-caption">Open an article to view details or edit its content.</p></div><a class="subtle-link" href="/articles">View all <%- include('partials/icon', {name:'arrow'}) %></a></div>
        <% if (!recent.length) { %><div class="empty-state"><%- include('partials/icon',{name:'article'}) %><h3>No articles available</h3><p>Create an article to start managing content.</p><a href="/articles/add" class="btn btn-primary">Create article</a></div><% } else { %>
        <div class="recent-list"><% for (const article of recent) { %><div class="recent-row"><span class="article-glyph tone-<%= ['blue','violet','green'][article.category % 3] %>"><%- include('partials/icon',{name:'article'}) %></span><div class="recent-title"><a href="/articles/<%= article.id %>"><%= article.title %></a><span><%= article.categoryName || 'Uncategorized' %> <span>·</span> <%= article.author %></span></div><span class="badge <%= article.published ? 'bg-green-lt' : 'bg-yellow-lt' %>"><%= article.published ? 'Published' : 'Unpublished' %></span><a class="icon-button" href="/articles/<%= article.id %>/edit" aria-label="Edit <%= article.title %>"><%- include('partials/icon',{name:'edit'}) %></a></div><% } %></div><% } %>
    </section>
    <section class="card draft-card"><div class="card-header"><div><h2 class="card-title">Unpublished articles</h2><p class="section-caption">Review and update these entries.</p></div><span class="badge bg-yellow-lt"><%= counts.drafts %></span></div><div class="card-body">
        <% if (!drafts.length) { %><div class="quiet-empty"><%- include('partials/icon',{name:'check'}) %><p>No unpublished articles.</p></div><% } %>
        <% for (const article of drafts) { %><a class="draft-item" href="/articles/<%= article.id %>/edit"><span class="small-eyebrow"><%= article.categoryName || 'Uncategorized' %></span><h3><%= article.title %></h3><span>Edit article <%- include('partials/icon',{name:'arrow'}) %></span></a><% } %>
    </div></section>
</div>
<section class="category-section"><div class="section-heading"><h2>Articles by category</h2><a class="subtle-link" href="/categories">All categories <%- include('partials/icon',{name:'arrow'}) %></a></div><div class="category-strip"><% for (const category of categories.slice(0,6)) { %><a class="category-chip" href="/articles?category=<%= category.id %>"><span class="category-small-icon"><%- include('partials/icon',{name:'category'}) %></span><span><%= category.Name %></span><strong><%= category.articleCount %></strong></a><% } %><% if (!categories.length) { %><p class="text-secondary">No categories yet. Add initial categories during database setup.</p><% } %></div></section>
<%- include('partials/end') %>
