<%- include('partials/start') %>
<div class="page-heading"><div><div class="eyebrow">CONTENT LIBRARY</div><h1>Articles</h1><p>Search, filter, and manage published and unpublished articles.</p></div><a href="/articles/add" class="btn btn-primary"><%- include('partials/icon',{name:'plus'}) %>New article</a></div>
<section class="card library-card">
    <div class="library-tabs"><div><a class="library-tab <%= !filters.status ? 'selected' : '' %>" href="<%= link({status:'',page:1}) %>">All articles</a><a class="library-tab <%= filters.status==='published' ? 'selected' : '' %>" href="<%= link({status:'published',page:1}) %>">Published</a><a class="library-tab <%= filters.status==='draft' ? 'selected' : '' %>" href="<%= link({status:'draft',page:1}) %>">Unpublished</a></div><div class="view-toggle" aria-label="Article layout"><a class="icon-button <%= filters.view==='table' ? 'selected' : '' %>" aria-label="Table view" <%- filters.view==='table' ? 'aria-current="true"' : '' %> href="<%= link({view:'table'}) %>"><%- include('partials/icon',{name:'table'}) %></a><a class="icon-button <%= filters.view==='gallery' ? 'selected' : '' %>" aria-label="Gallery view" <%- filters.view==='gallery' ? 'aria-current="true"' : '' %> href="<%= link({view:'gallery'}) %>"><%- include('partials/icon',{name:'category'}) %></a></div></div>
    <form class="filter-bar" method="GET" action="/articles"><input type="hidden" name="status" value="<%= filters.status %>"><input type="hidden" name="view" value="<%= filters.view %>"><div class="search-field"><%- include('partials/icon',{name:'search'}) %><label class="form-label" for="search">Search articles</label><input class="form-control" id="search" name="search" maxlength="200" placeholder="Search articles…" value="<%= filters.search %>"></div><div><label class="form-label" for="category-filter">Category</label><select class="form-select" id="category-filter" name="category"><option value="">All categories</option><% for (const category of categories) { %><option value="<%= category.id %>" <%= Number(filters.category)===category.id ? 'selected' : '' %>><%= category.Name %></option><% } %></select></div><div><label class="form-label" for="minDate">From article date</label><input class="form-control" type="date" name="minDate" id="minDate" aria-label="From article date" value="<%= filters.minDate %>"></div><div><label class="form-label" for="sort">Sort articles</label><select class="form-select" name="sort" id="sort"><option value="newest" <%= filters.sort==='newest' ? 'selected' : '' %>>Newest first</option><option value="oldest" <%= filters.sort==='oldest' ? 'selected' : '' %>>Oldest first</option><option value="title" <%= filters.sort==='title' ? 'selected' : '' %>>Title A–Z</option></select></div><button class="btn" type="submit">Apply</button><a class="clear-link" href="/articles?view=<%= filters.view %>">Reset</a></form>
    <% if (!articles.length) { %><div class="empty-state"><%- include('partials/icon',{name:'search'}) %><h2><%= filters.search || filters.category || filters.status || filters.minDate ? 'No matching articles.' : 'No articles available.' %></h2><p>Adjust the filters or create a new article.</p><a href="/articles/add" class="btn btn-primary">Create an article</a></div>
    <% } else if (filters.view === 'table') { %>
    <div class="table-responsive"><table class="table table-vcenter library-table"><thead><tr><th>Article</th><th>Status</th><th>Category</th><th>Article date</th><th>Actions</th></tr></thead><tbody><% for (const article of articles) { %><tr><td><div class="article-cell"><% if (imageUrl(article.featureImage)) { %><img class="table-cover" src="<%= imageUrl(article.featureImage) %>" alt="" loading="lazy"><% } else { %><span class="table-cover cover-placeholder tone-<%= ['blue','violet','green'][article.category % 3] %>"><%- include('partials/icon',{name:'article'}) %></span><% } %><div><a class="article-link" href="/articles/<%= article.id %>"><%= article.title %></a><span class="article-author"><%= article.author %></span></div></div></td><td><span class="badge <%= article.published ? 'bg-green-lt' : 'bg-yellow-lt' %>"><%= article.published ? 'Published' : 'Unpublished' %></span></td><td><a class="category-label" href="<%= link({category:article.category,page:1}) %>"><%= article.categoryName || 'Uncategorized' %></a></td><td class="text-secondary"><%= formatDate(article.articleDate) %></td><td><div class="row-actions"><a class="icon-button" href="/articles/<%= article.id %>/edit" aria-label="Edit <%= article.title %>"><%- include('partials/icon',{name:'edit'}) %></a><button class="icon-button delete-trigger" type="button" data-id="<%= article.id %>" data-title="<%= article.title %>" aria-label="Delete <%= article.title %>"><%- include('partials/icon',{name:'trash'}) %></button></div></td></tr><% } %></tbody></table></div>
    <% } else { %><div class="gallery-grid"><% for (const article of articles) { %><article class="gallery-card"><a class="gallery-cover cover-theme-<%= article.category % 3 %>" href="/articles/<%= article.id %>" aria-label="Read <%= article.title %>"><% if (imageUrl(article.featureImage)) { %><img src="<%= imageUrl(article.featureImage) %>" alt="" loading="lazy"><% } else { %><div class="cover-art" aria-hidden="true"><span></span><span></span><span></span></div><span class="cover-word"><%= article.categoryName || 'Ideas' %></span><% } %></a><div class="gallery-body"><div class="gallery-meta"><span><%= article.categoryName || 'Uncategorized' %></span><span class="badge <%= article.published ? 'bg-green-lt' : 'bg-yellow-lt' %>"><%= article.published ? 'Published' : 'Unpublished' %></span></div><h2><a href="/articles/<%= article.id %>"><%= article.title %></a></h2><p class="gallery-excerpt"><%= article.content %></p><div class="gallery-footer"><span><%= article.author %></span><a class="icon-button" href="/articles/<%= article.id %>/edit" aria-label="Edit <%= article.title %>"><%- include('partials/icon',{name:'edit'}) %></a><button type="button" class="icon-button delete-trigger" data-id="<%= article.id %>" data-title="<%= article.title %>" aria-label="Delete <%= article.title %>"><%- include('partials/icon',{name:'trash'}) %></button></div></div></article><% } %></div><% } %>
    <div class="library-footer"><span><%= total %> <%= total===1 ? 'article' : 'articles' %><% if (total) { %> · Page <%= page %> of <%= pages %><% } %></span><nav aria-label="Article pages" class="pagination-actions"><% if (page>1) { %><a class="btn btn-sm" href="<%= link({page:page-1}) %>">Previous</a><% } %><% if (page<pages) { %><a class="btn btn-sm" href="<%= link({page:page+1}) %>">Next</a><% } %></nav></div>
</section>
<%- include('partials/end') %>
