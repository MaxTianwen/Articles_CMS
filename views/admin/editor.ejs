<%- include('partials/start') %>
<div class="page-heading editor-heading"><div><a class="back-link" href="/articles">← Back to articles</a><h1><%= article.id ? 'Edit article' : 'New article' %></h1><p><%= article.id ? 'Update content and settings. The original article date is preserved.' : 'Enter article content, select a category, and save.' %></p></div><div class="heading-actions"><button class="btn" type="button" id="preview-button">Preview</button><button class="btn btn-primary" type="submit" form="article-form" id="save-button"><%- include('partials/icon',{name:'check'}) %><span>Save article</span></button></div></div>
<div class="alert alert-danger" id="form-error" role="alert" tabindex="-1" hidden></div>
<form id="article-form" class="editor-grid" data-article-id="<%= article.id || '' %>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <section class="card writing-card"><div class="writing-eyebrow"><%- include('partials/icon',{name:'edit'}) %> ARTICLE CONTENT</div><label class="visually-hidden" for="title">Article title</label><input class="title-input" id="title" name="title" maxlength="200" required placeholder="Enter article title" value="<%= article.title || '' %>" aria-describedby="error-title"><div class="invalid-feedback" id="error-title"></div><div class="editor-rule"></div><label class="form-label content-label" for="content">Article content <span>Plain text · paragraph breaks are preserved</span></label><textarea class="content-input" id="content" name="content" required maxlength="50000" placeholder="Enter article content" aria-describedby="error-content"><%= article.content || '' %></textarea><div class="invalid-feedback" id="error-content"></div><div class="writing-footer"><span id="word-count">0 words</span><span id="save-state" role="status">No unsaved changes</span></div></section>
    <aside class="editor-settings"><section class="card"><div class="card-header"><h2 class="card-title">Article settings</h2></div><div class="card-body"><div class="mb-4"><label class="form-label" for="published">Status</label><select name="published" id="published" class="form-select" aria-describedby="status-hint error-published"><option value="false" <%= !article.published ? 'selected' : '' %>>Unpublished</option><option value="true" <%= article.published ? 'selected' : '' %>>Published</option></select><div class="invalid-feedback" id="error-published"></div><p class="form-hint" id="status-hint">An internal status. This workspace has no public publishing site.</p></div><div class="mb-4"><label for="category" class="form-label">Category</label><select name="category" id="category" required class="form-select" aria-describedby="error-category"><option value="">Choose a category</option><% for (const category of categories) { %><option value="<%= category.id %>" <%= article.category===category.id ? 'selected' : '' %>><%= category.Name %></option><% } %></select><div class="invalid-feedback" id="error-category"></div><% if (!categories.length) { %><p class="form-hint">No categories available. Initial categories must be added during database setup.</p><% } %></div><div><label for="author" class="form-label">Author</label><input class="form-control" id="author" name="author" required maxlength="100" value="<%= article.author || admin.username %>" aria-describedby="error-author"><div class="invalid-feedback" id="error-author"></div></div><% if (article.id) { %><div class="article-date-note">Article date <strong><%= formatDate(article.articleDate) %></strong></div><% } %></div></section>
    <section class="card"><div class="card-header"><h2 class="card-title">Cover image</h2><span class="optional-label">Optional</span></div><div class="card-body"><div class="image-preview" id="image-preview"><img id="cover-preview" src="<%= imageUrl(article.featureImage) || '/image-placeholder.svg' %>" alt="Cover preview" data-original="<%= imageUrl(article.featureImage) || '/image-placeholder.svg' %>"></div><label for="featureImage" class="btn upload-label"><%- include('partials/icon',{name:'image'}) %>Choose image</label><input type="file" id="featureImage" name="featureImage" class="form-control mt-2" accept="image/jpeg,image/png,image/webp" aria-describedby="image-hint error-featureImage"><p class="form-hint" id="image-hint">JPEG, PNG or WebP. Up to 4 MB and 20 megapixels. Images are optimized for the web.</p><div class="invalid-feedback" id="error-featureImage"></div><button class="btn btn-sm btn-ghost-secondary" id="clear-new-image" type="button" hidden>Cancel new image</button><% if (article.featureImage) { %><label class="form-check mt-3"><input class="form-check-input" type="checkbox" id="removeImage" name="removeImage" value="true"><span class="form-check-label">Remove current cover</span></label><% } %></div></section></aside>
</form>
<dialog class="preview-dialog" id="preview-dialog" aria-labelledby="preview-heading"><div class="preview-toolbar"><strong id="preview-heading">Unsaved article preview</strong><button class="icon-button" id="close-preview" type="button" aria-label="Close preview"><%- include('partials/icon',{name:'close'}) %></button></div><article class="article-prose"><img id="preview-image" alt="Article cover"><div class="eyebrow" id="preview-category"></div><h1 id="preview-title"></h1><p class="article-byline" id="preview-author"></p><div class="prose-content" id="preview-content"></div></article></dialog>
<%- include('partials/end') %>
