<%- include('partials/start') %>
<div class="page-heading"><div><a class="back-link" href="/articles">← Back to articles</a><p class="preview-description">PRIVATE ARTICLE PREVIEW</p></div><div class="heading-actions"><button type="button" class="btn delete-trigger" data-id="<%= article.id %>" data-title="<%= article.title %>"><%- include('partials/icon',{name:'trash'}) %>Delete</button><a class="btn btn-primary" href="/articles/<%= article.id %>/edit"><%- include('partials/icon',{name:'edit'}) %>Edit article</a></div></div>
<article class="card article-preview-card"><div class="article-prose"><% if (imageUrl(article.featureImage)) { %><img class="article-hero-image" src="<%= imageUrl(article.featureImage) %>" alt="Cover for <%= article.title %>"><% } %><div class="article-kicker"><span class="eyebrow"><%= article.categoryName || 'Uncategorized' %></span><span class="badge <%= article.published ? 'bg-green-lt' : 'bg-yellow-lt' %>"><%= article.published ? 'Published' : 'Unpublished' %></span></div><h1><%= article.title %></h1><p class="article-byline">By <strong><%= article.author %></strong><span>·</span><%= formatDate(article.articleDate) %></p><div class="prose-content"><%= article.content %></div></div></article>
<%- include('partials/end') %>
