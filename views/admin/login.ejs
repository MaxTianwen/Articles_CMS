<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sign in · CONTENT DESK</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/vendor/tabler/css/tabler.min.css"><link rel="stylesheet" href="/css/admin.css"><script src="/js/admin.js" defer></script></head>
<body class="login-page"><main class="login-layout"><section class="login-story"><a class="brand" href="/login"><span class="brand-mark"><%- include('partials/icon',{name:'article'}) %></span><span class="brand-name">CONTENT DESK</span></a><div class="login-story-copy"><span class="eyebrow">CONTENT MANAGEMENT SYSTEM</span><h1>Content<br>administration</h1><p>Manage articles, categories, and publication status in one private workspace.</p></div><span class="login-story-footer">Authorized administrators only.</span><div class="login-orbit" aria-hidden="true"></div></section><section class="login-form-area"><div class="login-form-wrap"><span class="stat-icon tone-blue"><%- include('partials/icon',{name:'article'}) %></span><h2>Administrator sign-in</h2><p class="login-intro">Sign in to manage article content.</p><% if (demo) { %><div class="alert alert-info">Local demo only<br>Username: <strong>demo</strong><br>Password: <strong>Folio-demo-only-2026!</strong><br>Uses isolated sample data.</div><% } %><% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><form method="POST" action="/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="mb-4"><label for="username" class="form-label">Username</label><input class="form-control" id="username" name="username" autocomplete="username" required maxlength="64" value="<%= username %>" autofocus></div><div class="mb-4"><label for="password" class="form-label">Password</label><input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required maxlength="128"><label class="form-check mt-3"><input class="form-check-input" id="show-password" type="checkbox"><span class="form-check-label">Show password</span></label></div><button class="btn btn-primary w-100" type="submit">Sign in <%- include('partials/icon',{name:'arrow'}) %></button></form><p class="login-footnote">Administrator access only.<br>Need access? Contact the workspace owner.</p></div><span class="login-copyright">CONTENT DESK · Administrator access</span></section></main></body></html>
