NODE_ENV=development
PORT=3838
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE
# Remote databases require a verified TLS connection; local PostgreSQL can use false.
DATABASE_SSL=true
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set to 1 only behind a trusted single reverse proxy (including the intended Vercel setup).
TRUST_PROXY=0
